{
  "name": "autoclassroom-excel-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install --prefix frontend && pip install -r backend/requirements.txt",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python backend/app.py",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
